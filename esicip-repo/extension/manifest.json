{
  "manifest_version": 3,
  "name": "ESIC IP Auto-Fill",
  "version": "1.1.3",
  "description": "Auto-fills ESIC IP forms, auto-clicks Submit/Continue/Save (live-form), macro recording, and auto-updates from GitHub.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://portal.esic.gov.in/*",
    "https://www.esic.in/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ESIC IP Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.esic.gov.in/*",
        "https://www.esic.in/*"
      ],
      "js": [
        "dialog-patch.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.esic.gov.in/*",
        "https://www.esic.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
