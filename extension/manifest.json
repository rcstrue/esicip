{
  "manifest_version": 3,
  "name": "ESIC IP Auto-Fill",
  "version": "1.0.1",
  "description": "Auto-fills ESIC IP registration forms from a queue.json file. You just click Submit.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://portal.esic.gov.in/*",
    "https://www.esic.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ESIC IP Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.esic.gov.in/*",
        "https://www.esic.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
